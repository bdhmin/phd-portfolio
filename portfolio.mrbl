  <a data-marble-removable href="https://example.com" target="_blank" rel="noreferrer"><span data-marble-editable>New link</span><span class="arrow"><svg width="9" height="9" viewBox="0 0 9 9" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 1L1 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><path d="M2.39999 1L7.99999 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><path d="M8 6.60001L8 1.00001" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg></span></a>
</template>

<script>
(() => {
  const begin = (marble) => {
    const TRANSIENT = 'data-marble-transient';
    const ID = 'data-marble-id';

    const isTransient = (el) => el.hasAttribute(TRANSIENT);
    const persistentChildren = (el) => [...el.children].filter((c) => !isTransient(c));

    function nextPersistentSibling(el) {
      let sibling = el.nextElementSibling;
      while (sibling && isTransient(sibling)) sibling = sibling.nextElementSibling;
      return sibling;
    }

    // An element can hold several roles at once — a beat is both editable and a
    // sortable item — so wiring is tracked per role, not per element.
    const roles = new WeakMap();
    function claim(el, role) {
      const held = roles.get(el) ?? new Set();
      if (held.has(role)) return false;
      held.add(role);
      roles.set(el, held);
      return true;
    }

    const within = (root, selector) => [
      ...(root.matches?.(selector) ? [root] : []),
      ...root.querySelectorAll(selector),
    ];

    // Each part contributes its own styling, its own wiring pass, and the
    // selector for what it makes touchable — so removing a part removes all
    // three and nothing dangles.
    const css = [];
    const wirers = [];
    const addressable = [];

    // A subtree that isn't in the document yet can't be addressed by path, so
    // it carries its ids with it — they are serialized into the insert op.
    function assignIdsIn(root) {
      for (const el of [root, ...root.querySelectorAll('*')]) {
        if (isTransient(el) || marble.id(el)) continue;
        if (el === root || el.matches(ADDRESSABLE)) el.setAttribute(ID, marble.newId());
      }
    }

    css.push(`
      .marble-item { position: relative; }
      .marble-item.marble-dragging { opacity: .4; }
      .marble-grip {
        position: absolute; left: -1.5rem; top: .1rem;
        display: flex; flex-direction: column; gap: 2px;
        opacity: 0; transition: opacity .12s ease;
      }
      .marble-item:hover > .marble-grip, .marble-grip:focus-within { opacity: 1; }
      .marble-btn {
        width: 1.1rem; height: 1.1rem; padding: 0; border: 0; border-radius: 3px;
        background: none; color: currentColor; opacity: .35;
        font: 500 11px/1.1rem ui-monospace, SFMono-Regular, Menlo, monospace;
        text-align: center; cursor: pointer;
      }
      .marble-btn:hover { opacity: 1; background: rgba(127, 127, 127, .14); }
    `);

    function grip(item) {
      let grip = item.querySelector(':scope > .marble-grip');
      if (!grip) {
        grip = document.createElement('div');
        grip.className = 'marble-grip';
        grip.setAttribute(TRANSIENT, '');
        // The item may itself be editable, so the chrome has to be an atomic
        // island the caret can't wander into.
        grip.setAttribute('contenteditable', 'false');
        item.prepend(grip);
        item.classList.add('marble-item');
      }
      return grip;
    }

    // These live in the page and never in the file, which the carrier has no
    // way to know until it is told.
    marble.pageOnly('contenteditable', 'spellcheck');
    addressable.push('[data-marble-editable]');
    wirers.push(wireEditable);

    function wireEditable(root) {
      for (const el of within(root, '[data-marble-editable]')) {
        if (!claim(el, 'editable')) continue;

        // plaintext-only keeps the browser from injecting <div> and <br> soup
        // on Enter, so textContent stays the whole truth and setText is safe.
        el.setAttribute('contenteditable', 'plaintext-only');
        if (el.contentEditable !== 'plaintext-only') el.setAttribute('contenteditable', 'true');
        el.spellcheck = false;

        // One undo step per edit session: prior text is captured on focus, and
        // keystrokes coalesce against that same entry until blur.
        let prior = null;
        el.addEventListener('focus', () => {
          prior = marble.text(el);
        });
        el.addEventListener('input', () => {
          const id = marble.id(el);
          const text = marble.text(el);
          const op = { type: 'setText', id, text };
          if (prior !== null && text !== prior) {
            marble.record(
              { redo: [op], undo: [{ type: 'setText', id, text: prior }] },
              { coalesce: true },
            );
          }
          marble.op(op);
        });
        el.addEventListener('blur', () => {
          prior = null;
          marble.flush();
        });

        // Most editable nodes here are a heading or a single line, where Enter
        // means "done" and a newline buried in the text is a mistake you can't
        // see. Shift-Enter still breaks the line where a break is wanted.
        el.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' || (event.key === 'Enter' && !event.shiftKey)) {
            event.preventDefault();
            el.blur();
          }
        });
      }
    }

    css.push(`.marble-remove:hover { color: #b4544f; }`);
    addressable.push('[data-marble-removable]');
    wirers.push(wireRemovable);

    function wireRemovable(root) {
      for (const el of within(root, '[data-marble-removable]')) {
        if (!claim(el, 'removable')) continue;

        const button = document.createElement('button');
        button.className = 'marble-btn marble-remove';
        button.setAttribute(TRANSIENT, '');
        button.setAttribute('aria-label', 'Delete');
        button.title = 'Delete';
        button.textContent = '×';
        button.addEventListener('click', () => {
          const id = marble.id(el);
          // Invert against the live node — after remove, the prior state is gone.
          const inverse = marble.invert({ type: 'remove', id });
          el.remove();
          const op = { type: 'remove', id };
          if (inverse) marble.record({ redo: [op], undo: [inverse] });
          marble.op(op, { immediate: true });
        });
        grip(el).append(button);
      }
    }

    css.push(`
      .marble-handle { cursor: grab; }
      .marble-handle:active { cursor: grabbing; }
    `);
    marble.pageOnly('draggable');
    addressable.push('[data-marble-sortable]', '[data-marble-sortable] > *');
    wirers.push(wireSortable);

    let dragging = null;
    let origin = null;

    // Items move freely between containers declaring the same group.
    const group = (el) => el?.getAttribute('data-marble-sortable') ?? null;

    function wireSortableItem(item) {
      if (!claim(item, 'sortable-item')) return;

      const handle = document.createElement('button');
      handle.className = 'marble-btn marble-handle';
      handle.setAttribute(TRANSIENT, '');
      handle.setAttribute('draggable', 'true');
      handle.setAttribute('aria-label', 'Reorder');
      handle.title = 'Drag to reorder';
      handle.textContent = '⠿';

      handle.addEventListener('dragstart', (event) => {
        dragging = item;
        origin = { parent: item.parentElement, before: nextPersistentSibling(item) };
        item.classList.add('marble-dragging');
        event.dataTransfer.effectAllowed = 'move';
        event.dataTransfer.setData('text/plain', marble.id(item));
        event.dataTransfer.setDragImage(item, 12, 12);
      });

      handle.addEventListener('dragend', () => {
        if (!dragging) return;
        dragging.classList.remove('marble-dragging');
        commitMove();
        dragging = null;
        origin = null;
      });

      grip(item).prepend(handle);
    }

    function wireSortable(root) {
      for (const container of within(root, '[data-marble-sortable]')) {
        for (const item of persistentChildren(container)) wireSortableItem(item);
        if (!claim(container, 'sortable')) continue;

        // Reorder live during the drag, then report the final resting place.
        // Moving the element *is* the code change, not a trigger for one.
        container.addEventListener('dragover', (event) => {
          // Sortables nest — beats inside sections — so a container only
          // accepts items from a sortable of the same group, innermost first.
          if (!dragging || group(container) !== group(origin.parent)) return;
          event.stopPropagation();
          event.preventDefault();
          event.dataTransfer.dropEffect = 'move';

          const target = persistentChildren(container)
            .filter((child) => child !== dragging)
            .find((child) => {
              const rect = child.getBoundingClientRect();
              return event.clientY < rect.top + rect.height / 2;
            });

          const settled =
            dragging.parentElement === container &&
            (target ?? null) === nextPersistentSibling(dragging);
          if (!settled) container.insertBefore(dragging, target ?? null);
        });

        container.addEventListener('drop', (event) => event.preventDefault());
      }
    }

    function commitMove() {
      const parent = dragging.parentElement;
      const before = nextPersistentSibling(dragging);
      if (parent === origin.parent && before === origin.before) return;

      const op = {
        type: 'move',
        id: marble.id(dragging),
        parentId: marble.id(parent),
        beforeId: marble.id(before),
      };
      const inverse = {
        type: 'move',
        id: marble.id(dragging),
        parentId: marble.id(origin.parent),
        beforeId: marble.id(origin.before),
      };
      marble.record({ redo: [op], undo: [inverse] });
      marble.op(op, { immediate: true });
    }

    // <button data-marble-add="#tpl-section" data-marble-into="#outline">
    wirers.push(wireAdders);

    function wireAdders(root) {
      for (const button of within(root, '[data-marble-add]')) {
        if (!claim(button, 'adder')) continue;

        button.addEventListener('click', () => {
          const template = document.querySelector(button.dataset.marbleAdd);
          const into = button.dataset.marbleInto;
          // "prev" targets the list right before the button, so per-item adders
          // don't each need a unique selector.
          const container =
            into === 'prev' ? button.previousElementSibling : document.querySelector(into);
          const seed = template?.content?.firstElementChild;
          if (!seed || !container) {
            console.error('[marble] add: missing template or container', button.dataset);
            return;
          }

          const node = seed.cloneNode(true);
          assignIdsIn(node);
          // Serialized before wiring, so no transient chrome lands in the file.
          const html = marble.source.outer(node);

          container.append(node);
          marble.adopt(node);
          const op = { type: 'insert', html, parentId: marble.id(container), beforeId: null };
          const inverse = marble.invert(op);
          if (inverse) marble.record({ redo: [op], undo: [inverse] });
          marble.op(op, { immediate: true });

          node.querySelector('[data-marble-editable]')?.focus();
        });
      }
    }

    // HTML represents exactly one state: a heading is whatever it says, and the
    // three phrasings you were choosing between live in your head or in a
    // comment. <marble-alt> holds them as siblings and shows one. Which one is
    // showing is an attribute in the file, so switching is an ordinary setAttr.
    //
    //   <marble-alt data-marble-id="title" data-marble-active="v2">
    //     <h1 data-marble-alt="v1" data-marble-editable>…</h1>
    //     <h1 data-marble-alt="v2" data-marble-editable>…</h1>
    //   </marble-alt>
    //
    // Which one *displays* is the app's own stylesheet, not this file's
    // business — a document has to show the right version with no host at all.

    // Forked from Marble's template to match this site. The default is a
    // monospace pill switch with a white sliding thumb, which reads as a
    // control borrowed from somewhere else; here the thumb is the same hairline
    // the rest of the page rules with, and the type is the page's own.
    css.push(`
      .marble-alts {
        display: inline-flex; align-items: baseline; gap: 10px; margin-top: .4rem;
        font: 400 11px var(--sans, ui-sans-serif, system-ui, sans-serif);
        letter-spacing: .04em;
        user-select: none; opacity: .4; transition: opacity .16s ease;
      }
      marble-alt:hover .marble-alts, .marble-alts:focus-within { opacity: 1; }
      .marble-alts-track { position: relative; display: flex; gap: 2px; padding-bottom: 4px; }
      .marble-alts-thumb {
        position: absolute; left: 0; bottom: 0; height: 1px; width: 0;
        background: currentColor; opacity: .5;
        transition: transform .18s cubic-bezier(.32, .72, 0, 1), width .18s cubic-bezier(.32, .72, 0, 1);
      }
      .marble-alts-v {
        position: relative; padding: 0 5px; border: 0;
        background: none; color: var(--faint, #a1a1aa); cursor: pointer;
        font: inherit; letter-spacing: inherit;
      }
      .marble-alts-v:hover { color: var(--dim, #71717a); }
      .marble-alts-v[aria-pressed="true"] { color: var(--foreground, inherit); }
      .marble-alts-v:focus-visible { outline: 1px solid var(--rule, #e4e4e7); outline-offset: 2px; }
      .marble-alts button.marble-alts-edge {
        width: 14px; padding: 0; border: 0;
        background: none; color: var(--faint, #a1a1aa); cursor: pointer;
        font: inherit; line-height: 1;
      }
      .marble-alts button.marble-alts-edge:hover { color: var(--dim, #71717a); }
      .marble-alts .marble-alts-drop:hover { color: #b4544f; }
    `);
    addressable.push('marble-alt', 'marble-alt > *');
    wirers.push(wireAlternatives);

    const ALT = 'data-marble-alt';
    const ACTIVE = 'data-marble-active';

    const nameOf = (el) => el?.getAttribute(ALT) ?? null;

    function activeVersion(alt) {
      const versions = persistentChildren(alt);
      // An unrecognized name means the file was hand-edited into disagreement.
      // Falling back to the first version keeps something on screen either way.
      return versions.find((el) => nameOf(el) === alt.getAttribute(ACTIVE)) ?? versions[0] ?? null;
    }

    function nextName(versions) {
      const numbered = versions
        .map((el) => Number(/^v(\d+)$/.exec(nameOf(el) ?? '')?.[1]))
        .filter(Number.isFinite);
      return `v${Math.max(versions.length, ...numbered) + 1}`;
    }

    function wireAlternatives(root) {
      for (const alt of within(root, 'marble-alt')) {
        if (!claim(alt, 'alt')) continue;

        const widget = document.createElement('div');
        widget.className = 'marble-alts';
        widget.setAttribute(TRANSIENT, '');
        // The versions may themselves be editable, so the chrome has to be an
        // island the caret can't wander into.
        widget.setAttribute('contenteditable', 'false');
        widget.innerHTML = `
          <span class="marble-alts-track" role="group" aria-label="Versions">
            <span class="marble-alts-thumb"></span>
          </span>
          <button class="marble-alts-edge marble-alts-add" title="Add a version">+</button>
          <button class="marble-alts-edge marble-alts-drop" title="Delete this version">×</button>
        `;
        const track = widget.querySelector('.marble-alts-track');
        const thumb = widget.querySelector('.marble-alts-thumb');
        const drop = widget.querySelector('.marble-alts-drop');

        // No control decides what is on screen: each one writes the attribute
        // and the stylesheet reads it. That is why a switch arriving from a
        // text editor or a model lands exactly the way a click does.
        function setActive(name) {
          if (!name || alt.getAttribute(ACTIVE) === name) return null;
          const id = marble.id(alt);
          const undo = { type: 'setAttr', id, name: ACTIVE, value: alt.getAttribute(ACTIVE) };
          const redo = { type: 'setAttr', id, name: ACTIVE, value: name };
          alt.setAttribute(ACTIVE, name);
          marble.op(redo, { immediate: true });
          return { redo, undo };
        }

        function show(name) {
          const step = setActive(name);
          if (step) marble.record({ redo: [step.redo], undo: [step.undo] });
          render();
        }

        function render() {
          const versions = persistentChildren(alt);

          // A hand-written alternative needn't be named; naming it is a splice,
          // exactly like the ids assigned on first sight.
          versions.forEach((version, index) => {
            if (nameOf(version)) return;
            const name = `v${index + 1}`;
            version.setAttribute(ALT, name);
            if (marble.id(version)) {
              marble.op({ type: 'setAttr', id: marble.id(version), name: ALT, value: name });
            }
          });

          const current = activeVersion(alt);

          // Rebuilt only when the set of versions changes, so an ordinary
          // switch moves the thumb rather than replacing the control under the
          // cursor.
          const names = versions.map(nameOf);
          if (track.dataset.names !== names.join('\u0000')) {
            track.dataset.names = names.join('\u0000');
            for (const stale of track.querySelectorAll('button')) stale.remove();
            for (const name of names) {
              const button = document.createElement('button');
              button.className = 'marble-alts-v';
              button.dataset.name = name;
              button.textContent = name;
              button.addEventListener('click', () => show(name));
              track.append(button);
            }
          }

          for (const button of track.querySelectorAll('button')) {
            const on = button.dataset.name === nameOf(current);
            button.setAttribute('aria-pressed', String(on));
            if (!on) continue;
            thumb.style.width = `${button.offsetWidth}px`;
            thumb.style.transform = `translateX(${button.offsetLeft}px)`;
          }
          drop.hidden = versions.length < 2;
        }

        widget.querySelector('.marble-alts-add').addEventListener('click', () => {
          const current = activeVersion(alt);
          if (!current) return;

          // The new version starts as a copy of the one on screen, because a
          // candidate phrasing is nearly always an edit of the current one.
          const version = marble.clone(current);
          for (const el of [version, ...version.querySelectorAll(`[${ID}]`)]) {
            el.removeAttribute(ID);
          }
          const name = nextName(persistentChildren(alt));
          version.setAttribute(ALT, name);
          assignIdsIn(version);

          const html = marble.source.outer(version);
          alt.insertBefore(version, widget);
          marble.adopt(version);
          const insert = { type: 'insert', html, parentId: marble.id(alt), beforeId: null };
          marble.op(insert, { immediate: true });
          const active = setActive(name);
          const undo = [marble.invert(insert), active?.undo].filter(Boolean);
          const redo = [insert, active?.redo].filter(Boolean);
          if (undo.length && redo.length) marble.record({ redo, undo });
          render();

          version.focus();
          getSelection()?.selectAllChildren(version);
        });

        drop.addEventListener('click', () => {
          const versions = persistentChildren(alt);
          if (versions.length < 2) return;
          const at = versions.indexOf(activeVersion(alt));
          const doomed = versions[at];
          const next = nameOf(versions[at + 1] ?? versions[at - 1]);
          const remove = { type: 'remove', id: marble.id(doomed) };
          const removeUndo = marble.invert(remove);
          const active = setActive(next);
          doomed.remove();
          marble.op(remove, { immediate: true });
          const undo = [removeUndo, active?.undo].filter(Boolean);
          const redo = [active?.redo, remove].filter(Boolean);
          if (undo.length && redo.length) marble.record({ redo, undo });
          render();
        });

        track.addEventListener('keydown', (event) => {
          const step = { ArrowLeft: -1, ArrowRight: 1 }[event.key];
          if (!step) return;
          event.preventDefault();
          const versions = persistentChildren(alt);
          const at = versions.indexOf(activeVersion(alt));
          const name = nameOf(versions[(at + step + versions.length) % versions.length]);
          show(name);
          track.querySelector(`[data-name="${CSS.escape(name)}"]`)?.focus();
        });

        alt.append(widget);
        render();
        // The thumb is measured, so it needs one frame in which the text has
        // been laid out — and the widget may have been wired before its font
        // arrived.
        requestAnimationFrame(render);

        new MutationObserver(render).observe(alt, {
          attributes: true,
          attributeFilter: [ACTIVE],
          childList: true,
        });
      }
    }

    // Undo/redo is a carrier capability; binding the keys is the app's call,
    // same as drawing a save indicator. Native inputs keep the browser's own
    // undo — marble editables preventDefault so the stacks do not fight.
    addEventListener('keydown', (event) => {
      const mod = event.metaKey || event.ctrlKey;
      if (!mod || event.altKey) return;
      const key = event.key.toLowerCase();
      const isUndo = key === 'z' && !event.shiftKey;
      const isRedo = (key === 'z' && event.shiftKey) || key === 'y';
      if (!isUndo && !isRedo) return;

      const target = event.target;
      if (
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        (target instanceof HTMLElement &&
          target.isContentEditable &&
          !target.hasAttribute('data-marble-editable') &&
          !target.closest('[data-marble-editable]'))
      ) {
        return;
      }

      // A staged proposal is not history yet — Mod+Z discards it instead.
      if (isUndo && typeof marble.discardStaged === 'function' && marble.discardStaged()) {
        event.preventDefault();
        return;
      }

      if (isUndo && marble.canUndo) {
        event.preventDefault();
        marble.undo();
      } else if (isRedo && marble.canRedo) {
        event.preventDefault();
        marble.redo();
      }
    });

    // The carrier reports whether a change reached the file; drawing that is
    // the app's call, and an app that wants no save indicator deletes this.

    css.push(`
      .marble-status {
        position: fixed; right: 1rem; bottom: 1rem; z-index: 9999;
        padding: .3rem .6rem; border-radius: 999px;
        font: 500 11px ui-monospace, SFMono-Regular, Menlo, monospace;
        letter-spacing: .04em; pointer-events: none;
        opacity: 0; transition: opacity .25s ease;
        background: rgba(20, 22, 26, .92); color: #b7c0cc; border: 1px solid rgba(255,255,255,.12);
      }
      .marble-status[data-state="saving"] { opacity: 1; }
      .marble-status[data-state="saved"]  { opacity: .55; }
      .marble-status[data-state="error"]  { opacity: 1; background: #46201f; color: #ff9b9b; }
    `);

    const status = document.createElement('div');
    status.className = 'marble-status';
    status.setAttribute(TRANSIENT, '');
    document.body.append(status);

    let statusTimer = null;
    document.addEventListener('marble:status', ({ detail }) => {
      status.dataset.state = detail.state;
      status.textContent =
        detail.state === 'saving'
          ? 'saving…'
          : detail.state === 'saved'
            ? 'saved'
            : `error — ${detail.message}`;
      clearTimeout(statusTimer);
      if (detail.state === 'saved') {
        statusTimer = setTimeout(() => (status.dataset.state = 'idle'), 1200);
      }
    });

    const style = document.createElement('style');
    style.setAttribute(TRANSIENT, '');
    style.textContent = css.join('\n');
    document.head.append(style);

    // Anything a hand can act on has to be addressable in the file first.
    const ADDRESSABLE = addressable.join(', ');
    marble.address(document.querySelectorAll(ADDRESSABLE));

    // Runs now over the document as it stands, and again over anything that
    // arrives later — an insert, an accepted proposal, an edit made to the file
    // in another window.
    marble.register((root) => {
      for (const wirer of wirers) wirer(root);
    });
  };

  // The carrier is injected after the document has been parsed, so this waits
  // rather than the other way round. No carrier, no affordances: the document
  // is still a page you can read, it just isn't one you can change.
  if (window.marble) begin(window.marble);
  else addEventListener('marble:ready', (event) => begin(event.detail), { once: true });
})();
</script>
<script data-marble-id="richwire">
// The bio, as a rich block editor.
//
// The copied affordances do not cover this and should not: data-marble-editable
// files setText, whose whole premise is that the text *is* the block. A
// paragraph carrying <b> and a link is not that. So these blocks file setInner,
// and the difference matters for undo rather than for typing — a setText's
// inverse is another setText, so it cannot bring emphasis back, while a
// setInner's inverse carries the previous markup and can.
//
// The consequence, stated once here rather than repeated at every call site: an
// inline mark inside a rich block carries no data-marble-id. The block is the
// piece an op names, the same way an <svg> is addressable and its paths are
// not. Marks travel in the block's markup.
(() => {
  const begin = (marble) => {
    const RICH = '[data-marble-rich]';

    // The colours this site already uses, offered by name so a link written in
    // the editor lands as `class="tag tag-ucsd"` and inherits every later change
    // to that class. A colour picked by hand has no class to belong to, so it
    // goes inline on the one link it is true of.
    const PALETTE = [
      { name: 'ucsd', label: 'UCSD', light: '#00629B', dark: '#54AEE2' },
      { name: 'lab', label: 'Lab', light: '#A19792', dark: '#D7CAC3' },
      { name: 'cogsci', label: 'CogSci', light: '#EC6556', dark: '#F48175' },
      { name: 'masonview', label: 'Gold', light: '#f0b051', dark: '#f0b051' },
    ];

    const roles = new WeakMap();
    function claim(el, role) {
      const held = roles.get(el) ?? new Set();
      if (held.has(role)) return false;
      held.add(role);
      roles.set(el, held);
      return true;
    }
    const within = (root, sel) => [
      ...(root.matches?.(sel) ? [root] : []),
      ...root.querySelectorAll(sel),
    ];

    // Chrome: belongs to the page, never to the file, and the caret may not
    // wander into it.
    function chrome(tag, cls) {
      const el = document.createElement(tag);
      if (cls) el.className = cls;
      marble.transient(el);
      el.setAttribute('contenteditable', 'false');
      return el;
    }
    const svg = (body, size = 13) =>
      `<svg viewBox="0 0 14 14" width="${size}" height="${size}" fill="none" stroke="currentColor"
        stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;
    const ICON = {
      gallery: svg('<rect x="1.2" y="1.2" width="8.6" height="8.6" rx="1"/><path d="M4.2 12.8h7.6a1 1 0 0 0 1-1V4.2"/>'),
      upload: svg('<rect x="1.2" y="2.6" width="11.6" height="9.4" rx="1"/><path d="M7 10V5.4M7 5.4 5.3 7.1M7 5.4l1.7 1.7"/>'),
      link: svg('<path d="M5.6 8.4 8.4 5.6"/><path d="M7.6 4.3 8.9 3a2.3 2.3 0 0 1 3.2 3.2l-1.3 1.3"/><path d="M6.4 9.7 5.1 11A2.3 2.3 0 0 1 1.9 7.8l1.3-1.3"/>'),
      unlink: svg('<path d="M7.6 4.3 8.9 3a2.3 2.3 0 0 1 3.2 3.2l-1.3 1.3"/><path d="M6.4 9.7 5.1 11A2.3 2.3 0 0 1 1.9 7.8l1.3-1.3"/><path d="M2 2l10 10"/>'),
    };

    const style = document.createElement('style');
    marble.transient(style);
    style.textContent = `
      /* The caret is the focus indicator here. A block is a paragraph of the
         page, and ringing it in blue the moment it is clicked is the browser
         announcing an editor the rest of this design goes out of its way not
         to look like. */
      [data-marble-rich]:focus, [data-marble-rich]:focus-visible { outline: none; }
      .marble-rt button:focus-visible, .marble-pp button:focus-visible,
      .marble-gal button:focus-visible, .marble-lk-go:focus-visible {
        outline: 1px solid var(--dim, #71717a); outline-offset: 1px;
      }
      .marble-rt {
        position: fixed; z-index: 40; display: none;
        align-items: center; gap: 2px; padding: 3px 4px;
        background: var(--background, #fff); border: 1px solid var(--rule, #e4e4e7);
        border-radius: 3px; box-shadow: 0 2px 8px rgba(0,0,0,.07);
        font: 400 12px var(--sans, system-ui, sans-serif);
      }
      .marble-rt[data-open] { display: flex; }
      .marble-rt button {
        min-width: 22px; height: 22px; padding: 0 5px; border: 0; border-radius: 2px;
        background: none; color: var(--dim, #71717a); cursor: pointer;
        font: inherit; line-height: 1; display: inline-flex;
        align-items: center; justify-content: center;
      }
      .marble-rt button:hover { color: var(--foreground, #171717); background: rgba(127,127,127,.1); }
      .marble-rt button[aria-pressed="true"] { color: var(--foreground, #171717); }
      .marble-rt .marble-rt-b { font-weight: 700; }
      .marble-rt .marble-rt-i { font-style: italic; font-family: var(--serif, Georgia, serif); }
      .marble-rt .marble-rt-u { text-decoration: underline; text-underline-offset: 2px; }
      .marble-rt .marble-rt-sep { width: 1px; height: 14px; margin: 0 3px; background: var(--rule, #e4e4e7); }

      .marble-lk {
        position: fixed; z-index: 41; display: none;
        flex-direction: column; gap: 8px; padding: 9px 10px; width: 254px;
        background: var(--background, #fff); border: 1px solid var(--rule, #e4e4e7);
        border-radius: 3px; box-shadow: 0 3px 12px rgba(0,0,0,.09);
        font: 400 12px var(--sans, system-ui, sans-serif); color: var(--foreground, #171717);
      }
      .marble-lk[data-open] { display: flex; }
      .marble-lk input[type="url"] {
        width: 100%; padding: 4px 0; border: 0; border-bottom: 1px solid var(--rule, #e4e4e7);
        background: none; color: inherit; font: inherit; outline: none;
      }
      .marble-lk input[type="url"]:focus { border-bottom-color: var(--dim, #71717a); }
      .marble-lk-row { display: flex; align-items: center; gap: 6px; }
      .marble-lk-hint { color: var(--faint, #a1a1aa); font-size: 11px; letter-spacing: .04em; }
      .marble-sw {
        width: 15px; height: 15px; padding: 0; border: 1px solid rgba(127,127,127,.35);
        border-radius: 999px; cursor: pointer;
      }
      .marble-sw[aria-pressed="true"] { outline: 1px solid var(--dim, #71717a); outline-offset: 2px; }
      .marble-lk input[type="color"] {
        width: 17px; height: 17px; padding: 0; border: 0; background: none; cursor: pointer;
      }
      .marble-lk-go {
        margin-left: auto; padding: 2px 9px; border: 1px solid var(--rule, #e4e4e7);
        border-radius: 2px; background: none; color: var(--dim, #71717a);
        font: inherit; cursor: pointer;
      }
      .marble-lk-go:hover { color: var(--foreground, #171717); border-color: var(--dim, #71717a); }

      .marble-pp {
        position: absolute; left: 0; right: 0; bottom: 0;
        display: flex; justify-content: flex-end; gap: 2px; padding: 5px;
        opacity: 0; transition: opacity .14s ease;
      }
      [data-marble-portrait] { position: relative; }
      [data-marble-portrait]:hover .marble-pp, .marble-pp:focus-within { opacity: 1; }
      .marble-pp button {
        width: 22px; height: 22px; padding: 0; border: 0; border-radius: 2px;
        display: inline-flex; align-items: center; justify-content: center;
        background: rgba(255,255,255,.86); color: #27272a; cursor: pointer;
        box-shadow: 0 1px 3px rgba(0,0,0,.2);
      }
      .marble-pp button:hover { background: #fff; }

      .marble-gal {
        position: fixed; z-index: 41; display: none;
        grid-template-columns: repeat(4, 58px); gap: 6px; padding: 8px;
        background: var(--background, #fff); border: 1px solid var(--rule, #e4e4e7);
        border-radius: 3px; box-shadow: 0 3px 12px rgba(0,0,0,.09);
      }
      .marble-gal[data-open] { display: grid; }
      .marble-gal button {
        width: 58px; height: 70px; padding: 0; border: 1px solid transparent;
        border-radius: 2px; overflow: hidden; background: none; cursor: pointer;
      }
      .marble-gal button:hover { border-color: var(--dim, #71717a); }
      .marble-gal button[aria-pressed="true"] { border-color: var(--foreground, #171717); }
      .marble-gal img { width: 100%; height: 100%; object-fit: cover; display: block; }
    `;
    document.head.append(style);

    // ---------------------------------------------------------------- blocks

    // One undo step per editing session, captured on focus and coalesced until
    // blur — the same shape the copied editable uses, with markup where it has
    // text.
    const priorHtml = new WeakMap();

    function file(block, { immediate = false } = {}) {
      const id = marble.id(block);
      if (!id) return;
      const html = marble.source.inner(block);
      const prior = priorHtml.get(block);
      if (prior === html) return;
      const op = { type: 'setInner', id, html };
      if (prior !== undefined) {
        marble.record(
          { redo: [op], undo: [{ type: 'setInner', id, html: prior }] },
          { coalesce: true },
        );
      }
      marble.op(op, { immediate });
    }

    function blockOf(node) {
      const el = node?.nodeType === 1 ? node : node?.parentElement;
      return el?.closest(RICH) ?? null;
    }

    function wireRich(root) {
      for (const block of within(root, RICH)) {
        if (!claim(block, 'rich')) continue;

        block.setAttribute('contenteditable', 'true');
        block.spellcheck = false;

        block.addEventListener('focus', () => priorHtml.set(block, marble.source.inner(block)));
        block.addEventListener('input', () => file(block));
        block.addEventListener('blur', () => {
          file(block, { immediate: true });
          priorHtml.delete(block);
          marble.flush();
        });

        block.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            event.preventDefault();
            block.blur();
            return;
          }
          // Enter starts a block rather than a line, because the column's
          // spacing is what separates paragraphs here — a <br> would look
          // like a paragraph and not behave like one. Shift-Enter still breaks.
          if (event.key === 'Enter' && !event.shiftKey) {
            event.preventDefault();
            addBlockAfter(block);
            return;
          }
          // Backspace in an empty block removes the block, which is the only
          // way to get rid of one without reaching for the drag handle.
          if (event.key === 'Backspace' && !marble.text(block).trim()) {
            const siblings = within(block.parentElement, RICH);
            if (siblings.length < 2) return;
            event.preventDefault();
            removeBlock(block);
          }
        });
      }
    }

    function addBlockAfter(block) {
      const parent = block.parentElement;
      const parentId = marble.id(parent);
      if (!parentId) return;
      const next = block.nextElementSibling;
      const html = `<p data-marble-id="${marble.newId()}" data-marble-rich><br></p>`;
      const op = { type: 'insert', html, parentId, beforeId: next ? marble.id(next) : null };
      marble.apply(op);
      const inverse = marble.invert(op);
      if (inverse) marble.record({ redo: [op], undo: [inverse] });
      marble.op(op, { immediate: true });
      block.nextElementSibling?.focus();
    }

    function removeBlock(block) {
      const back = [...within(block.parentElement, RICH)];
      const before = back[back.indexOf(block) - 1] ?? back[back.indexOf(block) + 1];
      const op = { type: 'remove', id: marble.id(block) };
      const inverse = marble.invert(op);
      marble.apply(op);
      if (inverse) marble.record({ redo: [op], undo: [inverse] });
      marble.op(op, { immediate: true });
      if (!before) return;
      before.focus();
      const range = document.createRange();
      range.selectNodeContents(before);
      range.collapse(false);
      const sel = getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
    }

    // ------------------------------------------------------------- the toolbar

    const bar = chrome('div', 'marble-rt');
    bar.innerHTML = `
      <button class="marble-rt-b" data-cmd="bold" title="Bold">B</button>
      <button class="marble-rt-i" data-cmd="italic" title="Italic">I</button>
      <button class="marble-rt-u" data-cmd="underline" title="Underline">U</button>
      <span class="marble-rt-sep"></span>
      <button data-act="link" title="Link">${ICON.link}</button>
      <button data-act="unlink" title="Remove link">${ICON.unlink}</button>
    `;
    document.body.append(bar);

    const panel = chrome('div', 'marble-lk');
    panel.innerHTML = `
      <input type="url" placeholder="https://" spellcheck="false">
      <div class="marble-lk-row">
        <span class="marble-lk-hint">HOVER</span>
        <span class="marble-lk-row marble-lk-swatches"></span>
        <input type="color" value="#00629B" title="A colour of your own">
      </div>
      <div class="marble-lk-row">
        <span class="marble-lk-hint marble-lk-note"></span>
        <button class="marble-lk-go">Link</button>
      </div>
    `;
    document.body.append(panel);

    const field = panel.querySelector('input[type="url"]');
    const custom = panel.querySelector('input[type="color"]');
    const note = panel.querySelector('.marble-lk-note');
    const swatches = panel.querySelector('.marble-lk-swatches');
    let chosen = PALETTE[0].name;

    for (const entry of PALETTE) {
      const sw = document.createElement('button');
      sw.className = 'marble-sw';
      sw.dataset.name = entry.name;
      sw.title = entry.label;
      sw.style.background = entry.light;
      swatches.append(sw);
    }

    function paintSwatches() {
      for (const sw of swatches.querySelectorAll('.marble-sw')) {
        sw.setAttribute('aria-pressed', String(sw.dataset.name === chosen));
      }
      const named = PALETTE.find((e) => e.name === chosen);
      note.textContent = named ? `tag-${named.name}` : 'inline colour';
    }
    swatches.addEventListener('click', (event) => {
      const sw = event.target.closest('.marble-sw');
      if (!sw) return;
      chosen = sw.dataset.name;
      paintSwatches();
    });
    custom.addEventListener('input', () => {
      chosen = null;
      paintSwatches();
    });
    paintSwatches();

    // The selection is the argument to every one of these controls, and clicking
    // a control is how you lose it. Held here from the moment the toolbar is
    // shown, and put back before anything is applied.
    let held = null;
    const holdSelection = () => {
      const sel = getSelection();
      held = sel && sel.rangeCount ? sel.getRangeAt(0).cloneRange() : null;
    };
    function restoreSelection() {
      if (!held) return false;
      const sel = getSelection();
      sel.removeAllRanges();
      sel.addRange(held);
      return true;
    }

    const close = () => {
      panel.removeAttribute('data-open');
      bar.removeAttribute('data-open');
    };
    function place(el, rect) {
      el.style.left = `${Math.max(8, Math.min(rect.left, innerWidth - el.offsetWidth - 8))}px`;
      const above = rect.top - el.offsetHeight - 8;
      el.style.top = `${above > 8 ? above : rect.bottom + 8}px`;
    }

    document.addEventListener('selectionchange', () => {
      if (panel.hasAttribute('data-open')) return;
      const sel = getSelection();
      const block = sel && sel.rangeCount ? blockOf(sel.anchorNode) : null;
      if (!block || sel.isCollapsed || !block.isContentEditable) {
        bar.removeAttribute('data-open');
        return;
      }
      bar.setAttribute('data-open', '');
      place(bar, sel.getRangeAt(0).getBoundingClientRect());
      for (const button of bar.querySelectorAll('[data-cmd]')) {
        button.setAttribute('aria-pressed', String(document.queryCommandState(button.dataset.cmd)));
      }
      bar.querySelector('[data-act="unlink"]').hidden = !linkAt(sel.anchorNode);
    });

    const linkAt = (node) => {
      const el = node?.nodeType === 1 ? node : node?.parentElement;
      return el?.closest('a') ?? null;
    };

    // Mousedown is what would collapse the selection, so the controls take the
    // press and never the focus.
    for (const surface of [bar, panel]) {
      surface.addEventListener('mousedown', (event) => {
        if (!event.target.closest('input')) event.preventDefault();
      });
    }

    bar.addEventListener('click', (event) => {
      const button = event.target.closest('button');
      if (!button) return;
      const block = blockOf(getSelection()?.anchorNode);
      if (!block) return;

      if (button.dataset.cmd) {
        // styleWithCSS off so the mark lands as <b>/<i>/<u> rather than a span
        // carrying a style attribute — this file is read by hand.
        document.execCommand('styleWithCSS', false, false);
        document.execCommand(button.dataset.cmd);
        file(block, { immediate: true });
        button.setAttribute('aria-pressed', String(document.queryCommandState(button.dataset.cmd)));
        return;
      }
      if (button.dataset.act === 'unlink') {
        document.execCommand('unlink');
        file(block, { immediate: true });
        return;
      }
      if (button.dataset.act === 'link') {
        holdSelection();
        const existing = linkAt(getSelection()?.anchorNode);
        field.value = existing?.getAttribute('href') ?? '';
        panel.setAttribute('data-open', '');
        place(panel, bar.getBoundingClientRect());
        field.focus();
        field.select();
      }
    });

    function applyLink() {
      const url = field.value.trim();
      const block = blockOf(held?.startContainer);
      if (!url || !block) return close();

      restoreSelection();
      document.execCommand('unlink');
      document.execCommand('createLink', false, url);

      // execCommand may split the selection across several anchors; every one
      // of them is this link and gets the same dressing.
      for (const anchor of block.querySelectorAll('a[href]')) {
        if (anchor.getAttribute('href') !== url) continue;
        anchor.className = chosen ? `tag tag-${chosen}` : 'tag';
        if (chosen) anchor.removeAttribute('style');
        else anchor.setAttribute('style', `--tag-light: ${custom.value}; --tag-dark: ${custom.value}`);
        anchor.setAttribute('target', '_blank');
        anchor.setAttribute('rel', 'noreferrer');
      }
      file(block, { immediate: true });
      close();
    }
    panel.querySelector('.marble-lk-go').addEventListener('click', applyLink);
    field.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') { event.preventDefault(); applyLink(); }
      if (event.key === 'Escape') { event.preventDefault(); close(); }
    });

    document.addEventListener('mousedown', (event) => {
      if (!event.target.closest('.marble-rt, .marble-lk, .marble-gal')) close();
    });

    // ------------------------------------------------------------- the portrait

    const gallery = chrome('div', 'marble-gal');
    document.body.append(gallery);

    function wirePortrait(root) {
      for (const frame of within(root, '[data-marble-portrait]')) {
        if (!claim(frame, 'portrait')) continue;
        const img = frame.querySelector('img');
        if (!img) continue;

        const pick = chrome('div', 'marble-pp');
        const choose = document.createElement('button');
        choose.innerHTML = ICON.gallery;
        choose.title = 'Choose a portrait';
        const send = document.createElement('button');
        send.innerHTML = ICON.upload;
        send.title = 'Upload a portrait';
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = 'image/*';
        input.hidden = true;
        pick.append(choose, send, input);
        frame.append(pick);

        choose.addEventListener('click', () => openGallery(frame, img));
        send.addEventListener('click', () => input.click());
        input.addEventListener('change', async () => {
          const file0 = input.files?.[0];
          input.value = '';
          if (file0) setSrc(img, await downscale(file0));
        });
      }
    }

    function setSrc(img, src) {
      const id = marble.id(img);
      if (!id) return;
      const was = img.getAttribute('src');
      img.setAttribute('src', src);
      const op = { type: 'setAttr', id, name: 'src', value: src };
      marble.record({ redo: [op], undo: [{ type: 'setAttr', id, name: 'src', value: was }] });
      marble.op(op, { immediate: true });
    }

    function openGallery(frame, img) {
      const shelf = document.querySelector('#tpl-portraits');
      gallery.replaceChildren();
      const now = img.getAttribute('src');
      for (const option of shelf?.content.querySelectorAll('img') ?? []) {
        const button = document.createElement('button');
        const src = option.getAttribute('src');
        button.setAttribute('aria-pressed', String(src === now));
        button.title = option.getAttribute('alt') ?? src;
        const thumb = document.createElement('img');
        thumb.src = src;
        thumb.alt = '';
        button.append(thumb);
        button.addEventListener('click', () => {
          setSrc(img, src);
          gallery.removeAttribute('data-open');
        });
        gallery.append(button);
      }
      gallery.setAttribute('data-open', '');
      place(gallery, frame.getBoundingClientRect());
    }

    // An upload has nowhere to go but into the file, so it arrives as a data
    // URI — which is why it is resized on the way in rather than stored whole.
    // The slot is 200x240 CSS pixels; 3x that covers any screen worth serving
    // and a 4MB camera photo comes out around 60KB.
    function downscale(blob, edge = 720) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onerror = reject;
        reader.onload = () => {
          const image = new Image();
          image.onerror = reject;
          image.onload = () => {
            const scale = Math.min(1, edge / Math.max(image.width, image.height));
            const canvas = document.createElement('canvas');
            canvas.width = Math.round(image.width * scale);
            canvas.height = Math.round(image.height * scale);
            canvas.getContext('2d').drawImage(image, 0, 0, canvas.width, canvas.height);
            const url = canvas.toDataURL('image/jpeg', 0.82);
            console.info(`[portrait] ${canvas.width}x${canvas.height}, ${Math.round(url.length / 1024)}KB into the file`);
            resolve(url);
          };
          image.src = reader.result;
        };
        reader.readAsDataURL(blob);
      });
    }

    document.addEventListener('mousedown', (event) => {
      if (!event.target.closest('.marble-gal, .marble-pp')) gallery.removeAttribute('data-open');
    });

    marble.register((root) => {
      wireRich(root);
      wirePortrait(root);
    });
  };

  // No carrier, no editor: the bio is text you can read and a portrait you can
  // look at, which is exactly what a visitor gets.
  if (window.marble) begin(window.marble);
  else addEventListener('marble:ready', (event) => begin(event.detail), { once: true });
})();
</script>
</body>
</html>
